[global]
width = 300
heuight = 200
origin = top-right
offset = 20x60

#appearance
padding = 16
hirizontal_padding = 16
frame_width = 2
frame_color = "#33ccff"
separator_color = frame
font = JetBrainsMono Nerd Font
corner_radius = 10

# Background Colors
background = "#0a0e17E6"
foreground = "#c0caf5"

# Progress Bars
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300
progress_bar_corner_radius = 4
highlight = "#00ff99"

[urgency_low]
    background = "#0a0e17E6"
    foreground = "#c0caf5"
    frame_color = "#414868"

[urgency_normal]
    background = "#0a0e17E6"
    foreground = "#c0caf5"
    frame_color = "#33ccff"

[urgency_critical]
    background = "#0a0e17E6"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0

